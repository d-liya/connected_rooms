# Root URL for game assets (images, audio, voices). Leave empty for same-origin
# assets (Vite dev server, or files deployed next to index.html). For production
# on Cloudflare R2, mirror public/assets to the CDN root and point here, e.g.
# with assets/manor.png at https://assets.example.com/assets/manor.png:
# VITE_ASSET_BASE_URL=https://assets.example.com
VITE_ASSET_BASE_URL=

# Gameplay analytics (Capybara game server). Enabled by default: the client at
# VITE_GAME_API_CLIENT_URL is loaded lazily and startPlaytimeTracking(gameId)
# captures play activity. The gameId defaults to the active story's
# GameDefinition.id.
VITE_GAME_ID=
VITE_ANALYTICS_ENABLED=true
VITE_GAME_API_CLIENT_URL=https://assets.capybara.build/js/game-api-client.js
# Optional override for the API host the client talks to (defaults to the
# client's built-in https://game-server.capybara.build).
VITE_GAME_SERVER_URL=
